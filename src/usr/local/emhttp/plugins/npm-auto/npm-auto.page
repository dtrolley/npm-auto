Menu="User Utilities"
Title="npm-auto"
Icon="folder-open-o"
---
<?php
$settings_file = "/boot/config/plugins/npm-auto/var/settings.json";
$cleanup_file  = "/boot/config/plugins/npm-auto/var/cleanup_request.json";

// Form field name => canonical settings key. Only these are ever persisted.
$field_map = [
    'npm_enabled'       => 'NPM_ENABLED',
    'npm_host'          => 'NPM_HOST',
    'npm_port'          => 'NPM_PORT',
    'npm_user'          => 'NPM_USER',
    'npm_pass'          => 'NPM_PASS',
    'default_domain'    => 'DEFAULT_DOMAIN',
    'label_overrides'   => 'LABEL_OVERRIDES',
    'auto_ssl'          => 'AUTO_SSL',
    'toggle_off_action' => 'TOGGLE_OFF_ACTION',
];
$checkboxes = ['npm_enabled', 'label_overrides', 'auto_ssl'];

if ($_POST) {
    $settings = [];
    foreach ($field_map as $field => $key) {
        if (in_array($field, $checkboxes)) {
            $settings[$key] = isset($_POST[$field]);
        } else {
            $settings[$key] = (string)($_POST[$field] ?? '');
        }
    }
    if (!in_array($settings['TOGGLE_OFF_ACTION'], ['keep', 'disable', 'delete'])) {
        $settings['TOGGLE_OFF_ACTION'] = 'disable';
    }
    $dir = dirname($settings_file);
    if (!is_dir($dir)) mkdir($dir, 0755, true);
    file_put_contents($settings_file, json_encode($settings, JSON_PRETTY_PRINT));

    // If the plugin was just disabled and the user chose a cleanup action in
    // the prompt, hand it to the daemon.
    $cleanup = $_POST['cleanup_action'] ?? '';
    if (!$settings['NPM_ENABLED'] && in_array($cleanup, ['disable', 'delete'])) {
        file_put_contents($cleanup_file, json_encode(['action' => $cleanup]));
    }
}

$settings = [];
if (file_exists($settings_file)) {
    $decoded = json_decode(file_get_contents($settings_file), true);
    if (is_array($decoded)) $settings = $decoded;
}

// Map canonical keys back to form field names for the UI.
$form_values = [];
foreach ($field_map as $field => $key) {
    if (array_key_exists($key, $settings)) $form_values[$field] = $settings[$key];
}

require_once("/usr/local/emhttp/plugins/npm-auto/webGui/settings_ui.php");
?>
<script>
  $(document).ready(function() {
    const settings = <?= json_encode($form_values) ?>;
    for (const [key, value] of Object.entries(settings)) {
      const input = $(`#${key}`);
      if (input.is(':checkbox')) {
        input.prop('checked', value === true);
      } else {
        input.val(value);
      }
    }
    // Remember whether the plugin was enabled when the page loaded, so the
    // submit handler can detect an enabled -> disabled transition.
    $('#npm-auto-settings-form').data('was-enabled', settings.npm_enabled === true);
  });
</script>
