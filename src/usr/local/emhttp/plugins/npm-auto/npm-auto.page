Menu="User Utilities"
Title="npm-auto"
Icon="folder-open-o"
---
<?php
$settings_file = "/boot/config/plugins/npm-auto/var/settings.json";
$cleanup_file  = "/boot/config/plugins/npm-auto/var/cleanup_request.json";

// Form field name => canonical settings key. Only these are ever persisted.
$field_map = [
    'npm_enabled'       => 'NPM_ENABLED',
    'npm_host'          => 'NPM_HOST',
    'npm_port'          => 'NPM_PORT',
    'npm_user'          => 'NPM_USER',
    'npm_pass'          => 'NPM_PASS',
    'default_domain'    => 'DEFAULT_DOMAIN',
    'label_overrides'   => 'LABEL_OVERRIDES',
    'auto_ssl'          => 'AUTO_SSL',
    'toggle_off_action' => 'TOGGLE_OFF_ACTION',
];
$checkboxes = ['npm_enabled', 'label_overrides', 'auto_ssl'];

// Settings currently on the flash, or [] on a fresh install.
function npm_auto_read_settings($file) {
    if (!file_exists($file)) return [];
    $decoded = json_decode(file_get_contents($file), true);
    return is_array($decoded) ? $decoded : [];
}

if ($_POST) {
    $previous = npm_auto_read_settings($settings_file);
    $settings = [];
    foreach ($field_map as $field => $key) {
        if (in_array($field, $checkboxes)) {
            $settings[$key] = isset($_POST[$field]);
        } else {
            $settings[$key] = (string)($_POST[$field] ?? '');
        }
    }
    // The stored password is never sent to the browser, so the field comes
    // back empty unless the user typed a new one: keep the old one then.
    if ($settings['NPM_PASS'] === '') {
        $settings['NPM_PASS'] = (string)($previous['NPM_PASS'] ?? '');
    }
    if (!in_array($settings['TOGGLE_OFF_ACTION'], ['keep', 'disable', 'delete'])) {
        $settings['TOGGLE_OFF_ACTION'] = 'disable';
    }
    $dir = dirname($settings_file);
    if (!is_dir($dir)) mkdir($dir, 0755, true);
    file_put_contents($settings_file, json_encode($settings, JSON_PRETTY_PRINT));

    // If the plugin was just disabled and the user chose a cleanup action in
    // the prompt, hand it to the daemon.
    $cleanup = $_POST['cleanup_action'] ?? '';
    if (!$settings['NPM_ENABLED'] && in_array($cleanup, ['disable', 'delete'])) {
        file_put_contents($cleanup_file, json_encode(['action' => $cleanup]));
    }
}

$settings = npm_auto_read_settings($settings_file);

// Map canonical keys back to form field names for the UI. The password is
// left out: it would otherwise sit in the page source of every visit.
$form_values = [];
foreach ($field_map as $field => $key) {
    if ($field === 'npm_pass') continue;
    if (array_key_exists($key, $settings)) $form_values[$field] = $settings[$key];
}
$npm_pass_saved = ($settings['NPM_PASS'] ?? '') !== '';

// Pre-fill sensible defaults for a fresh install: NPM ships OOTB on the
// Unraid host at port 81. Both remain fully customizable.
if (($form_values['npm_host'] ?? '') === '') {
    if (preg_match('/src (\S+)/', shell_exec("ip route get 1 2>/dev/null") ?? '', $m)) {
        $form_values['npm_host'] = $m[1];
    }
}
if (($form_values['npm_port'] ?? '') === '') {
    $form_values['npm_port'] = '81';
}

require_once("/usr/local/emhttp/plugins/npm-auto/webGui/settings_ui.php");
?>
<script>
  $(document).ready(function() {
    const settings = <?= json_encode($form_values, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
    for (const [key, value] of Object.entries(settings)) {
      const input = $(`#${key}`);
      if (input.is(':checkbox')) {
        input.prop('checked', value === true);
      } else {
        input.val(value);
      }
    }
    // A password is already saved: leaving the field blank keeps it.
    if (<?= $npm_pass_saved ? 'true' : 'false' ?>) {
      $('#npm_pass').prop('required', false)
        .attr('placeholder', 'Saved - leave blank to keep');
    }
    // Remember whether the plugin was enabled when the page loaded, so the
    // submit handler can detect an enabled -> disabled transition.
    $('#npm-auto-settings-form').data('was-enabled', settings.npm_enabled === true);
  });
</script>
